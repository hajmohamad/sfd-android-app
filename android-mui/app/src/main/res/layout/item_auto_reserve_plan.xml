<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Checkbox + Day & Meal + Price Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbIncludeMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:checked="true" />

            <TextView
                android:id="@+id/tvPlanDayMeal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="شنبه ۲۵ مهر (ناهار)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlanPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_capacity"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="۵۰,۰۰۰ ریال"
                android:textColor="@color/badge_capacity_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dropdowns container (dimmed if unchecked) -->
        <LinearLayout
            android:id="@+id/llPlanDropdowns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <!-- Food Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="غذای انتخابی:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spPlanFood"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_spinner" />

            <!-- Self Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="محل تحویل (سلف):"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spPlanSelf"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_spinner" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
