<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Day Title & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="شنبه ۱۴۰۵/۰۷/۲۵"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_reserved"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="رزرو شده"
                android:textColor="@color/badge_reserved_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day Self Location & Difference Alert Row -->
        <LinearLayout
            android:id="@+id/llDaySelfIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_building_location"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDaySelfIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="محل تحویل: سلف اختران (برادران)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/tvDifferentSelfNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="@color/badge_warning_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="سلف این روز متفاوت است"
                    android:textColor="@color/badge_warning_text"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Container shown when meal is already reserved -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/reservedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/badge_reserved_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F0FDF4"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_badge_reserved">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_circle_fill"
                        app:tint="@color/badge_reserved_text" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReservedFood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="غذای رزرو شده: چلو کباب کوبیده"
                        android:textColor="@color/badge_reserved_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReservedSelf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="محل تحویل: سلف اختران (برادران)"
                        android:textColor="#166534"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelReserve"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="لغو رزرو"
                    android:textColor="@color/badge_danger_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_cancel_circle"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="@color/badge_danger_text"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/badge_danger_border" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Container shown when meal is available for new reservation -->
        <LinearLayout
            android:id="@+id/selectionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <!-- Day specific self selector dropdown (when day has multiple options) -->
            <LinearLayout
                android:id="@+id/llDaySelfSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سلف تحویل این روز:"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <Spinner
                    android:id="@+id/spDaySelf"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_spinner" />
            </LinearLayout>

            <!-- Food Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="انتخاب غذا از منو (مرتب‌شده از ارزان‌ترین به گران‌ترین):"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <Spinner
                android:id="@+id/spFoods"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_spinner" />

            <!-- Price and Reserve Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="قیمت: ۵۰,۰۰۰ ریال"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReserve"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/primary"
                    android:paddingHorizontal="16dp"
                    android:text="رزرو این وعده"
                    android:textColor="@color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_order_food"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
